# Filled in by the nginx image at start-up (${...} values come from environment variables).
server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 1m;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's built-in DNS. Resolving per request means a restarted API container
    # is found again without restarting nginx.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $api_upstream http://${API_HOST}:${API_PORT};

    # Certificate PDFs open in the browser's own viewer, which does not get along with a strict
    # Content-Security-Policy header, so this one path gets the other security headers only.
    location ~ ^/api/certificates/[A-Za-z0-9-]+/pdf$ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_read_timeout 30s;
    }

    # Everything the Python backend answers.
    location ~ ^/(api/|healthz$) {
        include /etc/nginx/snippets/security.conf;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_read_timeout 30s;
    }

    # Python in the browser: the worker script and the Pyodide files. They get the strict worker
    # policy and the right content types for modules and WebAssembly. The file names do not change
    # between versions, so the browser must re-check them (a quick 304 when nothing changed).
    location ~ ^/(runners|pyodide)/ {
        include /etc/nginx/snippets/worker-security.conf;
        types {
            text/javascript mjs;
            application/wasm wasm;
            application/json json;
            application/zip zip;
        }
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Built files have hashed names, so they can be cached for a year.
    location /assets/ {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The React app (any other path falls back to index.html).
    location / {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
