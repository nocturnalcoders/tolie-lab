# deploy/setup.sh creates the real .env for you. Never commit it.
POSTGRES_PASSWORD=generated
LAB_SECRET_KEY=generated
LAB_SITE_URL=https://lab.tolie.space

# Email verification (optional). Set LAB_EMAIL_VERIFICATION=1 once SMTP works.
LAB_EMAIL_VERIFICATION=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payments for paid modules (optional). Both keys come from the Stripe dashboard; see README.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# A learning day (for the streak) starts at midnight in this timezone.
LAB_TIMEZONE=Asia/Jakarta

# Off-site copy of the nightly backup (optional): an rclone remote and folder, e.g. b2:tolie-lab-backups
BACKUP_RCLONE_REMOTE=
